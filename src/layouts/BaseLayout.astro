---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Maranatha Dental — Gentle Family & Cosmetic Dentistry | Garden Grove, CA',
  description = 'A calm, judgment-free dental home in Garden Grove. Cleanings, cosmetic & whitening, crowns, Invisalign, kids and emergency care — with most major insurance accepted and flexible financing. Book your visit.',
  image = '/images/hero.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Maranatha Dental',
  image: new URL('/images/hero.jpg', Astro.site).toString(),
  telephone: '+1-714-537-7773',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '11122 Trask Ave',
    addressLocality: 'Garden Grove',
    addressRegion: 'CA',
    postalCode: '92843',
    addressCountry: 'US',
  },
  url: canonical,
  priceRange: '$$',
  areaServed: ['Garden Grove', 'Westminster', 'Santa Ana', 'Anaheim', 'Orange County'],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Friday'], opens: '09:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'], opens: '09:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '15:00' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = 'light'; /* light is the default look; visitor can toggle to dark */
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f3" />
    <!-- Speculative demo concept — keep out of search results so it can't be
         mistaken for the official site or mislead patients. -->
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Maranatha Dental" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-4 focus:left-4 focus:bg-teal focus:text-white focus:px-4 focus:py-2 focus:rounded-full focus:font-semibold">Skip to content</a>
    <div id="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCTA />

    <script is:inline>
      // --- Lead form handler: posts to Web3Forms; demo-mode success when no key ---
      const initLeadForms = () => {
        document.querySelectorAll('form.lead-form').forEach((form) => {
          if (form.dataset.bound) return;
          form.dataset.bound = '1';
          const card = form.closest('[data-form-card]') || form.parentElement;
          const status = card.querySelector('[data-status]');
          const btn = form.querySelector('button[type="submit"]');
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!form.checkValidity()) { form.reportValidity(); return; }
            const key = form.dataset.key || '';
            const payload = Object.fromEntries(new FormData(form));
            const original = btn.textContent;
            btn.disabled = true; btn.textContent = 'Sending…';
            try {
              if (key && key.indexOf('YOUR_') !== 0) {
                const res = await fetch('https://api.web3forms.com/submit', {
                  method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                  body: JSON.stringify({ access_key: key, subject: form.dataset.subject || 'New appointment request', ...payload })
                });
                const json = await res.json();
                if (!json.success) throw new Error(json.message || 'submit failed');
              } else {
                await new Promise((r) => setTimeout(r, 650)); // demo mode — add a Web3Forms key to deliver for real
              }
              form.hidden = true;
              if (status) { status.hidden = false; status.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
            } catch (err) {
              btn.disabled = false; btn.textContent = original;
              alert('Sorry — something went wrong sending that. Please call us at (714) 537-7773 and we’ll take care of you.');
            }
          });
        });
      };
      initLeadForms();
      document.addEventListener('astro:after-swap', initLeadForms);

      // --- Theme toggle ---
      const initThemeToggle = () => {
        const btn = document.getElementById('theme-toggle');
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          const next = cur === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      };
      initThemeToggle();
      document.addEventListener('astro:after-swap', initThemeToggle);

      // --- Before/After whitening reveal slider ---
      const initBeforeAfter = () => {
        document.querySelectorAll('.ba').forEach((fig) => {
          const range = fig.querySelector('.ba-range');
          if (!range || range.dataset.bound) return;
          range.dataset.bound = '1';
          const update = () => fig.style.setProperty('--pos', range.value);
          range.addEventListener('input', update, { passive: true });
          update();
        });
      };
      initBeforeAfter();
      document.addEventListener('astro:after-swap', initBeforeAfter);

      // --- Respect reduced motion: hold background video on its poster frame ---
      const initHeroVideo = () => {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll('video[data-hero-video]').forEach((v) => {
          v.removeAttribute('autoplay'); v.loop = false;
          try { v.pause(); v.currentTime = 0; } catch (e) {}
        });
      };
      initHeroVideo();
      document.addEventListener('astro:after-swap', initHeroVideo);

      // --- Hero parallax (desktop only, motion-safe, rAF-throttled) ---
      const initParallax = () => {
        if (!window.matchMedia('(hover: hover)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const el = document.querySelector('[data-parallax]');
        const scope = el && el.closest('section');
        if (!el || !scope || scope.dataset.pbound) return;
        scope.dataset.pbound = '1';
        let raf = 0;
        scope.addEventListener('mousemove', (e) => {
          const r = scope.getBoundingClientRect();
          const x = ((e.clientX - r.left) / r.width - 0.5) * -14;
          const y = ((e.clientY - r.top) / r.height - 0.5) * -14;
          if (raf) return;
          raf = requestAnimationFrame(() => { el.style.transform = `translate3d(${x}px, ${y}px, 0)`; raf = 0; });
        });
        scope.addEventListener('mouseleave', () => { el.style.transform = ''; });
      };
      initParallax();
      document.addEventListener('astro:after-swap', initParallax);

      // --- Signature word reveal: split headings into words that rise in sequence ---
      const initSplitReveal = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll('[data-split] h1, [data-split] h2').forEach((el) => {
          if (el.dataset.split || el.querySelector('input, button, textarea, select')) return;
          el.dataset.split = '1';
          el.classList.add('split');
          let i = 0;
          const wrap = (node) => {
            Array.from(node.childNodes).forEach((child) => {
              if (child.nodeType === 3) {
                if (!child.textContent.trim()) return;
                const frag = document.createDocumentFragment();
                child.textContent.split(/(\s+)/).forEach((part) => {
                  if (part === '') return;
                  if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); return; }
                  const s = document.createElement('span');
                  s.className = 'word'; s.style.setProperty('--wi', i++); s.textContent = part;
                  frag.appendChild(s);
                });
                node.replaceChild(frag, child);
              } else if (child.nodeType === 1 && child.tagName !== 'BR') { wrap(child); }
            });
          };
          wrap(el);
        });
        const splitEls = document.querySelectorAll('.split:not(.in)');
        const show = (el) => el.classList.add('in');
        if (!('IntersectionObserver' in window)) { splitEls.forEach(show); return; }
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        splitEls.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 0.96 && r.bottom > 0) show(el); else io.observe(el);
        });
        setTimeout(() => document.querySelectorAll('.split:not(.in)').forEach(show), 2600);
      };
      initSplitReveal();
      document.addEventListener('astro:after-swap', initSplitReveal);

      // --- Scroll progress + adaptive header ---
      const bar = document.getElementById('scroll-progress');
      const siteHeader = document.getElementById('site-header');
      const onScrollProgress = () => {
        const h = document.documentElement;
        if (bar) { const max = h.scrollHeight - h.clientHeight; bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%'; }
        if (siteHeader) siteHeader.setAttribute('data-solid', h.scrollTop > 50 ? 'true' : 'false');
      };
      window.addEventListener('scroll', onScrollProgress, { passive: true });
      onScrollProgress();

      // --- Count-up numbers ---
      const initCountUp = () => {
        const els = document.querySelectorAll('[data-count]:not([data-counted])');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) { els.forEach((el) => { el.textContent = el.getAttribute('data-count') + (el.getAttribute('data-suffix') || ''); }); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target; io.unobserve(el); el.setAttribute('data-counted', '1');
            const target = parseInt(el.getAttribute('data-count'), 10) || 0;
            const suffix = el.getAttribute('data-suffix') || '';
            let start = null;
            const step = (ts) => {
              if (start === null) start = ts;
              const p = Math.min((ts - start) / 1400, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(target * eased) + (p === 1 ? suffix : '');
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        }, { threshold: 0.4 });
        els.forEach((el) => io.observe(el));
      };
      initCountUp();
      document.addEventListener('astro:after-swap', initCountUp);

      // --- Scroll reveals ---
      const runReveal = () => {
        const els = document.querySelectorAll('.reveal:not(.in), .reveal-left:not(.in), .reveal-scale:not(.in)');
        if (!('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('in')); return; }
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); } });
        }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < vh * 0.92 && rect.bottom > 0) el.classList.add('in');
          else io.observe(el);
        });
      };
      runReveal();
      document.addEventListener('astro:after-swap', runReveal);
    </script>
  </body>
</html>
