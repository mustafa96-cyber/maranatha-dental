---
// New-patient offer CTA band — clearly labelled as a sample offer for this preview.
const TEL = 'tel:+17145377773';
---
<section class="py-16 sm:py-20" aria-label="New patient offer">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal-scale relative overflow-hidden rounded-[2rem] bg-coral text-[#22140d] px-6 sm:px-12 py-12 sm:py-14">
      <div class="absolute -right-10 -top-12 w-56 h-56 rounded-full bg-white/20 blobby" aria-hidden="true"></div>
      <div class="absolute -left-8 -bottom-14 w-48 h-48 rounded-full bg-[#22140d]/10 floaty" aria-hidden="true"></div>

      <div class="relative grid lg:grid-cols-[1.3fr_0.7fr] gap-8 items-center">
        <div>
          <span class="inline-flex items-center gap-2 bg-[#22140d]/15 text-[#22140d] text-[0.62rem] font-bold uppercase tracking-[0.18em] px-3 py-1 rounded-full mb-5">Sample offer · new patients</span>
          <h2 class="font-display text-[clamp(1.9rem,4.6vw,3.1rem)] font-semibold leading-[1.02] text-balance">New patient exam, cleaning &amp; digital X-rays</h2>
          <p class="text-[#22140d]/80 text-base sm:text-lg leading-relaxed mt-4 max-w-xl">A gentle, welcoming first visit at a friendly new-patient rate. Perfect for getting to know us — no insurance required.</p>
          <p class="text-[#22140d]/70 text-xs mt-4 max-w-xl">Illustrative promotion for this website preview. Ask the office to confirm current new-patient pricing, terms, and eligibility.</p>
        </div>
        <div class="flex flex-col gap-3 lg:items-end">
          <div class="text-center lg:text-right">
            <p class="font-display text-6xl sm:text-7xl font-bold leading-none">$89<span class="align-top text-2xl">*</span></p>
            <p class="text-[#22140d]/70 text-sm mt-1">sample new-patient special</p>
          </div>
          <a href="/#book" class="btn btn-ink w-full lg:w-auto justify-center">Claim this visit</a>
          <a href={TEL} class="text-[#22140d] font-semibold text-sm underline underline-offset-4 hover:opacity-80">or call (714) 537-7773</a>
        </div>
      </div>
    </div>
  </div>
</section>
