---
// Insurance & financing clarity — plain, honest framing (no specific plan claims).
const points = [
  {
    title: 'Most major PPO insurance',
    body: 'We accept most major PPO dental plans and file your claims for you. Not sure about yours? Call and we’ll check before your visit.',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Flexible payment plans',
    body: 'Spread treatment over manageable monthly payments so cost never stands between you and a healthy smile.',
    icon: 'M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3M3.75 5.25h16.5a1.5 1.5 0 011.5 1.5v10.5a1.5 1.5 0 01-1.5 1.5H3.75a1.5 1.5 0 01-1.5-1.5V6.75a1.5 1.5 0 011.5-1.5z',
  },
  {
    title: 'Clear quotes, up front',
    body: 'You’ll get a straightforward estimate before we begin any treatment — no mystery bills afterward.',
    icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  },
  {
    title: 'No insurance? No problem',
    body: 'Paying out of pocket? Ask about our options for uninsured patients — we’ll help you find an affordable path.',
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
  },
];
---
<section id="insurance" class="py-20 sm:py-28 scroll-mt-20" data-split>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-start">
      <div class="lg:sticky lg:top-28">
        <p class="reveal chip text-coral-ink mb-4 flex items-center gap-3"><span class="hair w-9"></span> Insurance &amp; financing</p>
        <h2 class="reveal font-display text-ink text-[clamp(2rem,4.8vw,3.3rem)] font-semibold leading-[1.03] text-balance">Clarity about cost — before you sit in the chair.</h2>
        <p class="reveal text-ink-soft text-base sm:text-lg leading-relaxed mt-5">Great care shouldn’t come with financial anxiety. We keep things transparent and work with you to make treatment affordable.</p>
        <a href="tel:+17145377773" class="reveal btn btn-primary mt-8">Check my coverage</a>
        <p class="reveal text-ink-soft text-xs mt-4 max-w-sm">Coverage varies by plan. Please confirm your specific benefits with our front desk or your insurer.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
        {points.map((p, i) => (
          <article class="reveal lift card-soft p-6" style={`animation-delay:${i * 90}ms`}>
            <span class="inline-flex w-11 h-11 rounded-xl bg-cream-2 items-center justify-center mb-4" aria-hidden="true">
              <svg class="w-5.5 h-5.5 text-teal-ink" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon} /></svg>
            </span>
            <h3 class="font-display text-lg font-semibold text-ink leading-snug">{p.title}</h3>
            <p class="text-ink-soft text-sm leading-relaxed mt-2">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
