---
// FAQ — addresses the real worries: anxiety, cost, and the first visit.
const faqs = [
  {
    q: 'I get really nervous at the dentist. Can you help?',
    a: 'Absolutely — nervous patients are a big part of who we care for. Just let us know when you book. We go slowly, explain each step, check in often, and never make you feel rushed or judged.',
  },
  {
    q: 'What happens at my first visit?',
    a: 'We start with a friendly chat about your goals and any concerns, then a gentle exam and digital X-rays if needed. We’ll walk you through what we see and your options — and only move forward when you’re comfortable.',
  },
  {
    q: 'How much will treatment cost?',
    a: 'You’ll always get a clear estimate before any treatment begins. We accept most major PPO insurance, file claims for you, and offer flexible payment plans so cost is never a surprise.',
  },
  {
    q: 'Do you see children and whole families?',
    a: 'Yes. We welcome kids and adults alike and make first visits for little ones easy and positive. Booking the whole family on one trip? We’re happy to help coordinate.',
  },
  {
    q: 'Do you take dental emergencies?',
    a: 'Toothaches and broken or knocked-out teeth need prompt care. Call us as early in the day as you can and we’ll do our best to fit you in for a same-week urgent visit.',
  },
  {
    q: 'What are your hours and where are you located?',
    a: 'We’re at 11122 Trask Ave, Garden Grove, CA 92843. We’re open Monday–Friday (until 7pm Tue–Thu) and Saturday 9am–3pm — six days a week for your convenience.',
  },
];
---
<section id="faq" class="py-20 sm:py-28 scroll-mt-20" data-split>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
      <div class="lg:sticky lg:top-28 self-start">
        <p class="reveal chip text-coral-ink mb-4 flex items-center gap-3"><span class="hair w-9"></span> Good questions</p>
        <h2 class="reveal font-display text-ink text-[clamp(2rem,4.8vw,3.3rem)] font-semibold leading-[1.03] text-balance">The things people ask us most.</h2>
        <p class="reveal text-ink-soft text-base leading-relaxed mt-5">Still wondering about something? We’re happy to talk it through — no obligation.</p>
        <a href="tel:+17145377773" class="reveal btn btn-outline mt-7">Call and ask us anything</a>
      </div>

      <div class="reveal">
        {faqs.map((f) => (
          <details class="faq py-5">
            <summary class="flex items-start justify-between gap-4">
              <span class="font-display text-lg sm:text-xl font-semibold text-ink leading-snug">{f.q}</span>
              <span class="chev shrink-0 mt-1 inline-flex w-7 h-7 rounded-full bg-cream-2 items-center justify-center text-teal-ink" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              </span>
            </summary>
            <div class="faq-body"><div><p class="text-ink-soft leading-relaxed pt-3 pr-10 max-w-2xl">{f.a}</p></div></div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
