---
// Prominent dental-emergency callout — high-intent, one-tap to call. Calm deep
// spruce band with a coral phone button so it reads urgent without feeling scary.
const PHONE = '(714) 537-7773';
const TEL = 'tel:+17145377773';
---
<section id="emergency" class="force-dark relative py-16 sm:py-20 scroll-mt-20 overflow-hidden bg-teal-deep text-cream" aria-label="Dental emergencies">
  <div class="absolute -right-16 -bottom-20 w-72 h-72 rounded-full bg-coral/15 blobby" aria-hidden="true"></div>
  <div class="absolute -left-14 -top-16 w-56 h-56 rounded-full bg-mint/10 floaty" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 relative">
    <div class="grid lg:grid-cols-[1.4fr_1fr] gap-8 lg:gap-12 items-center">
      <div class="reveal">
        <span class="inline-flex items-center gap-2 bg-coral text-[#22140d] text-[0.62rem] font-bold uppercase tracking-[0.18em] px-3 py-1 rounded-full mb-5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M8.5 2.5 1 15.5h17L10.5 2.5a1.15 1.15 0 0 0-2 0z"/><rect x="9" y="7.5" width="2" height="4.5" rx="1" fill="#093f39"/><circle cx="10" cy="13.6" r="1.1" fill="#093f39"/></svg>
          In pain? We're here
        </span>
        <h2 class="font-display text-cream text-[clamp(1.9rem,4.6vw,3.1rem)] font-semibold leading-[1.03] text-balance">Dental emergency? Don't wait it out.</h2>
        <p class="text-cream/80 text-base sm:text-lg leading-relaxed mt-4 max-w-xl">A bad toothache, a broken or knocked-out tooth, swelling, or a lost filling or crown all need prompt attention. Call us as early in the day as you can and we'll do our best to fit you in for a same-week urgent visit.</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 mt-6">
          {['Severe toothache', 'Broken or chipped tooth', 'Knocked-out tooth', 'Lost filling or crown', 'Swelling or abscess'].map((t) => (
            <li class="flex items-center gap-2 text-cream/90 text-sm font-medium">
              <svg class="w-4 h-4 text-mint shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd" /></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal-scale">
        <a href={TEL} class="group flex items-center gap-4 p-5 rounded-2xl bg-cream/5 hover:bg-cream/10 border border-mint/25 transition-colors" aria-label={`Call Maranatha Dental now at ${PHONE}`}>
          <span class="inline-flex w-14 h-14 rounded-full bg-coral text-[#22140d] items-center justify-center shrink-0 floaty" aria-hidden="true">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" /></svg>
          </span>
          <span>
            <span class="block text-cream/60 text-xs uppercase tracking-wider">Call us now</span>
            <span class="block font-display text-2xl sm:text-3xl font-semibold text-cream group-hover:text-mint transition-colors">{PHONE}</span>
          </span>
        </a>
        <a href="/#book" class="btn w-full justify-center mt-3" style="background:#faf8f3;color:#093f39;">Or request a visit online</a>
        <p class="text-cream/60 text-xs mt-4 leading-relaxed">If you have severe swelling, trouble breathing or swallowing, or uncontrolled bleeding, call 911 or go to the nearest emergency room.</p>
      </div>
    </div>
  </div>
</section>
