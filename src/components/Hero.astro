---
// Welcoming hero — friendly serif headline on a warm-white ground with a soft
// mint glow + a bento of real, non-scary dental photography. No text over photo.
const TEL = 'tel:+17145377773';
const PHONE = '(714) 537-7773';
---
<section class="relative overflow-hidden pt-[104px] pb-16 lg:pt-[120px] lg:pb-20">
  <!-- soft ambient background -->
  <div class="absolute inset-0 -z-10" style="background: radial-gradient(120% 95% at 82% -5%, color-mix(in srgb, var(--color-mint) 55%, var(--color-cream)) 0%, var(--color-cream) 52%);"></div>
  <div class="absolute -z-10 top-[-8%] right-[-10%] w-[46vw] h-[46vw] max-w-[560px] max-h-[560px] blobby floaty opacity-60" style="background: radial-gradient(circle at 40% 40%, color-mix(in srgb, var(--color-mint) 90%, #fff), transparent 70%);" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 w-full">
    <div class="grid lg:grid-cols-[1.02fr_0.98fr] gap-10 lg:gap-14 items-center lg:min-h-[calc(100svh-120px)]">

      <!-- LEFT -->
      <div class="order-2 lg:order-1" data-split>
        <p class="reveal chip text-coral-ink mb-6 flex items-center gap-3">
          <span class="hidden sm:block hair w-9"></span> Gentle family &amp; cosmetic dentistry · Garden Grove
        </p>
        <h1 class="reveal font-display text-ink text-[clamp(2.5rem,5.6vw,4.5rem)] font-semibold leading-[1.0] text-balance" style="animation-delay:60ms;">
          A dentist you'll actually <span class="text-teal-ink italic">look forward</span> to.
        </h1>
        <p class="reveal text-ink-soft text-base sm:text-lg leading-relaxed max-w-lg mt-6" style="animation-delay:180ms;">
          Calm rooms, honest answers, and gentle hands — for the whole family.
          From routine cleanings to a brighter smile, we make dental care feel
          easy, judgment-free, and genuinely welcoming.
        </p>
        <div class="reveal flex flex-wrap items-center gap-3 mt-8" style="animation-delay:280ms;">
          <a href="/#book" class="btn btn-primary text-base">
            Book your visit
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href={TEL} class="btn btn-outline text-base" aria-label={`Call Maranatha Dental at ${PHONE}`}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" /></svg>
            {PHONE}
          </a>
        </div>
        <ul class="reveal flex flex-wrap items-center gap-x-6 gap-y-3 mt-9 pt-7 border-t border-ink/10" style="animation-delay:380ms;">
          {['Judgment-free, gentle care', 'Most insurance accepted', 'Open 6 days a week'].map((t) => (
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-teal-ink" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd" /></svg>
              <span class="text-ink font-medium text-sm">{t}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- RIGHT — bento of real photography -->
      <div class="order-1 lg:order-2 relative">
        <div data-parallax class="grid grid-cols-2 grid-rows-5 gap-3 sm:gap-4 h-[440px] sm:h-[540px] lg:h-[588px]">
          <figure class="relative col-start-1 row-span-3 rounded-[1.6rem] overflow-hidden group shadow-[0_24px_50px_-30px_rgba(20,50,43,0.6)]">
            <img src="/images/hero.jpg" alt="A bright, modern Maranatha Dental treatment room" class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" fetchpriority="high" width="800" height="1000" />
            <figcaption class="absolute bottom-3 left-3 bg-teal-deep/80 backdrop-blur text-cream text-[0.66rem] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full">Our clinic</figcaption>
          </figure>
          <figure class="relative col-start-2 row-span-2 rounded-[1.6rem] overflow-hidden group shadow-[0_24px_50px_-30px_rgba(20,50,43,0.6)]">
            <video
              class="w-full h-full object-cover object-center transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
              data-hero-video
              autoplay muted loop playsinline preload="metadata"
              poster="/video/smile-hero-poster.jpg"
              width="1280" height="720"
              aria-label="A happy patient smiling — real, judgment-free dental care">
              <source src="/video/smile-hero.mp4" type="video/mp4" />
            </video>
            <span class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/10 rounded-[1.6rem]" style="box-shadow: inset 0 -40px 60px -30px rgba(6,28,25,0.55);" aria-hidden="true"></span>
            <figcaption class="absolute bottom-3 left-3 bg-coral text-[#22140d] text-[0.66rem] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">Happy smiles</figcaption>
          </figure>
          <figure class="relative col-start-2 row-span-3 rounded-[1.6rem] overflow-hidden group shadow-[0_24px_50px_-30px_rgba(20,50,43,0.6)]">
            <img src="/images/room.jpg" alt="A dentist gently explaining treatment to a patient" class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" loading="eager" width="600" height="700" />
            <figcaption class="absolute bottom-3 left-3 bg-cream/90 text-ink text-[0.66rem] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">We explain everything</figcaption>
          </figure>
          <figure class="relative col-start-1 row-span-2 rounded-[1.6rem] overflow-hidden group shadow-[0_24px_50px_-30px_rgba(20,50,43,0.6)]">
            <img src="/images/family.jpg" alt="A father and his two children smiling together" class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" loading="eager" width="600" height="500" />
            <figcaption class="absolute bottom-3 left-3 bg-teal text-white text-[0.66rem] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">Care for all ages</figcaption>
          </figure>
        </div>
        <!-- floating badge -->
        <div class="absolute -top-4 -left-3 sm:-left-6 w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-coral text-[#22140d] flex flex-col items-center justify-center text-center shadow-2xl rotate-[-8deg] floaty">
          <span class="font-display text-[0.56rem] uppercase tracking-[0.16em] opacity-80">Loved by the</span>
          <span class="font-display text-xl sm:text-2xl font-bold leading-tight">neighbor-<br/>hood</span>
        </div>
      </div>

    </div>
  </div>
</section>
