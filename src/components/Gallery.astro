---
// Office tour — a calm, full-bleed marquee of the real space so patients can
// picture themselves here before they ever walk in. Two rows drift in opposite
// directions; the second copy of each row is decorative (aria-hidden) for a
// seamless loop. Uses the shared .gmar marquee styles.
const rowA = [
  { src: '/images/reception.jpg', cap: 'Warm, welcoming reception' },
  { src: '/images/room.jpg', cap: 'Calm, modern treatment rooms' },
  { src: '/images/hero.jpg', cap: 'Bright, spotless clinic' },
  { src: '/images/family.jpg', cap: 'Care for every age' },
];
const rowB = [
  { src: '/images/smile.jpg', cap: 'Smiles we love to see' },
  { src: '/images/smile-man.jpg', cap: 'Confident, healthy results' },
  { src: '/images/room.jpg', cap: 'Comfort at every visit' },
  { src: '/images/reception.jpg', cap: 'A space that feels easy' },
];
---
<section id="tour" class="relative py-20 sm:py-28 scroll-mt-20 overflow-hidden bg-cream-2" data-split aria-label="Office tour">
  <div class="absolute -z-10 top-[-6%] left-[-6%] w-[32vw] h-[32vw] max-w-[400px] max-h-[400px] rounded-full blobby opacity-40" style="background: radial-gradient(circle at 45% 45%, color-mix(in srgb, var(--color-mint) 82%, #fff), transparent 70%);" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl mb-12">
      <p class="reveal chip text-coral-ink mb-4 flex items-center gap-3"><span class="hair w-9"></span> Step inside</p>
      <h2 class="reveal font-display text-ink text-[clamp(2rem,4.8vw,3.3rem)] font-semibold leading-[1.03] text-balance">A calm, bright space — see it before you visit.</h2>
      <p class="reveal text-ink-soft text-base sm:text-lg leading-relaxed mt-5">No sterile, clinical dread here. Take a quick look around the rooms and reception where we'll take good care of you.</p>
    </div>
  </div>

  <!-- Full-bleed marquee rows -->
  <div class="reveal space-y-4 overflow-hidden" style="mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);">
    <div class="gmar">
      {[...rowA, ...rowA].map((img, i) => (
        <figure class="relative shrink-0 group overflow-hidden rounded-[1.1rem] shadow-[0_20px_44px_-30px_rgba(20,50,43,0.7)]">
          <img src={img.src} alt={i < rowA.length ? img.cap : ''} aria-hidden={i >= rowA.length ? 'true' : undefined} loading="lazy" width="480" height="320" class="transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" />
          <figcaption class="force-dark absolute bottom-2.5 left-2.5 bg-teal-deep/80 backdrop-blur text-cream text-[0.62rem] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full">{img.cap}</figcaption>
        </figure>
      ))}
    </div>
    <div class="gmar rev">
      {[...rowB, ...rowB].map((img, i) => (
        <figure class="relative shrink-0 group overflow-hidden rounded-[1.1rem] shadow-[0_20px_44px_-30px_rgba(20,50,43,0.7)]">
          <img src={img.src} alt={i < rowB.length ? img.cap : ''} aria-hidden={i >= rowB.length ? 'true' : undefined} loading="lazy" width="480" height="320" class="transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" />
          <figcaption class="force-dark absolute bottom-2.5 left-2.5 bg-teal-deep/80 backdrop-blur text-cream text-[0.62rem] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full">{img.cap}</figcaption>
        </figure>
      ))}
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 mt-12">
    <div class="reveal flex flex-wrap items-center gap-3">
      <a href="/#book" class="btn btn-primary">Book your visit</a>
      <a href="tel:+17145377773" class="btn btn-outline">Call the office</a>
    </div>
    <p class="text-ink-soft/70 text-xs mt-5 max-w-xl">Photos are representative of a modern dental office, shown for this website preview.</p>
  </div>
</section>
