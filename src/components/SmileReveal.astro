---
// Signature "wow" moment — a calming, draggable before/after whitening reveal.
// Same photo, two honest CSS tints (a duller "before" and a brighter "after"),
// clearly labelled as an illustrative simulation. Keyboard + touch accessible.
---
<section id="reveal" class="relative py-20 sm:py-28 scroll-mt-20 overflow-hidden" data-split>
  <!-- soft ambient glows -->
  <div class="absolute -z-10 -top-10 left-[-8%] w-[38vw] h-[38vw] max-w-[460px] max-h-[460px] rounded-full blobby opacity-50" style="background: radial-gradient(circle at 40% 40%, color-mix(in srgb, var(--color-mint) 85%, #fff), transparent 70%);" aria-hidden="true"></div>
  <div class="absolute -z-10 bottom-[-6%] right-[-6%] w-[30vw] h-[30vw] max-w-[380px] max-h-[380px] rounded-full floaty opacity-40" style="background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--color-coral) 55%, transparent), transparent 70%);" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-14 items-center">

      <!-- Copy -->
      <div>
        <p class="reveal chip text-coral-ink mb-4 flex items-center gap-3"><span class="hair w-9"></span> The whitening effect</p>
        <h2 class="reveal font-display text-ink text-[clamp(2rem,4.8vw,3.3rem)] font-semibold leading-[1.03] text-balance">See the smile you could walk out with.</h2>
        <p class="reveal text-ink-soft text-base sm:text-lg leading-relaxed mt-5 max-w-md">Slide across to preview the kind of brightening our gentle whitening can bring. No pressure — just a friendly look at what's possible for your smile.</p>
        <div class="reveal mt-8 flex flex-wrap gap-3">
          <a href="/#book" class="btn btn-primary">Ask about whitening</a>
          <a href="tel:+17145377773" class="btn btn-outline">Call the office</a>
        </div>
        <p class="reveal inline-flex items-center gap-2 text-teal-ink text-sm font-semibold mt-6 lg:hidden">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l-4 3 4 3m8-6 4 3-4 3M3 12h18" /></svg>
          Drag the handle to reveal
        </p>
      </div>

      <!-- Interactive slider -->
      <div>
        <figure class="reveal-scale ba group relative w-full aspect-[4/3] sm:aspect-[16/11] rounded-[1.75rem] overflow-hidden select-none shadow-[0_30px_64px_-34px_rgba(20,50,43,0.7)]" style="--pos:52">
          <!-- AFTER (brighter) sits underneath, revealed on the right -->
          <div class="ba-after absolute inset-0">
            <img src="/images/smile-man.jpg" alt="A bright, confident smile after professional whitening" class="w-full h-full object-cover" loading="lazy" width="900" height="700" />
          </div>
          <!-- BEFORE (duller) clipped to the left -->
          <div class="ba-before absolute inset-0">
            <img src="/images/smile-man.jpg" alt="" aria-hidden="true" class="w-full h-full object-cover" loading="lazy" width="900" height="700" />
          </div>

          <span class="ba-label ba-label-before">Before</span>
          <span class="ba-label ba-label-after">After</span>

          <!-- handle line + grip -->
          <div class="ba-handle" aria-hidden="true">
            <span class="ba-grip">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l-4 3 4 3m8-6 4 3-4 3" /></svg>
            </span>
          </div>

          <input type="range" min="0" max="100" value="52" step="0.5" class="ba-range" aria-label="Drag to reveal the whitening result" />
        </figure>
        <p class="text-ink-soft/80 text-xs mt-4 max-w-lg">Illustrative simulation shown on a single photo for this preview — the same image with a lighter and a warmer tint. Actual whitening results vary from person to person.</p>
      </div>

    </div>
  </div>
</section>
