---
// Mobile-only sticky bottom bar — call or book, always one tap away.
const TEL = 'tel:+17145377773';
---
<div class="h-[68px] lg:hidden" aria-hidden="true"></div>
<div class="sticky-bar lg:hidden fixed bottom-0 inset-x-0 z-40 bg-teal-deep/96 backdrop-blur border-t border-mint/20 px-4 py-3 flex gap-3 shadow-[0_-8px_24px_-12px_rgba(0,0,0,0.35)]" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
  <a href={TEL} class="flex-1 btn btn-cream justify-center !py-3 !px-3" aria-label="Call Maranatha Dental">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" /></svg>
    Call
  </a>
  <a href="/#book" class="flex-[1.5] btn btn-coral justify-center !py-3">Book appointment</a>
</div>
