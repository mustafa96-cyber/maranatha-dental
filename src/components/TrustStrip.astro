---
// Gentle, family-friendly trust marquee on a calming deep-teal band.
const items = [
  'Judgment-free care',
  'Most PPO insurance accepted',
  'Flexible payment plans',
  'Gentle with anxious patients',
  'Kids & families welcome',
  'Same-week emergency visits',
  'Cosmetic & family dentistry',
  'Open 6 days a week',
  'Saturday appointments',
  'We explain every step',
];
const loop = [...items, ...items];
---
<section class="force-dark bg-teal-deep text-cream py-5 overflow-hidden" aria-label="What patients can count on">
  <div class="ticker-track">
    {loop.map((t) => (
      <span class="inline-flex items-center gap-3 px-6 text-[0.95rem] font-medium tracking-wide text-cream/90 whitespace-nowrap">
        <svg class="w-4 h-4 text-mint shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.6 12.5 7l5.9.5-4.5 3.9 1.4 5.8L10 14.9 4.7 17.2l1.4-5.8L1.6 7.5 7.5 7z"/></svg>
        {t}
      </span>
    ))}
  </div>
</section>
