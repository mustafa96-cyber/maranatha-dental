---
// Meet the practice — only verifiable facts (public listing: Dr. Frank Chang, DDS).
// No invented portraits, no fabricated numbers.
---
<section id="about" class="py-20 sm:py-28 scroll-mt-20 overflow-hidden" data-split>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Copy -->
      <div class="order-2 lg:order-1">
        <p class="reveal chip text-coral-ink mb-4 flex items-center gap-3"><span class="hair w-9"></span> Our practice</p>
        <h2 class="reveal font-display text-ink text-[clamp(2rem,4.8vw,3.3rem)] font-semibold leading-[1.03] text-balance">A neighborhood dental home in Garden Grove.</h2>
        <p class="reveal text-ink-soft text-base sm:text-lg leading-relaxed mt-5">Maranatha Dental is a family and cosmetic dental practice on Trask Avenue, led by <strong class="text-ink font-semibold">Dr. Frank Chang, DDS</strong>. Patients from across Orange County trust us for gentle, honest care — the kind that turns nervous first-timers into long-time regulars.</p>
        <p class="reveal text-ink-soft text-base sm:text-lg leading-relaxed mt-4">From routine cleanings to full smile makeovers, our focus is simple: treat every person like a neighbor, explain every option in plain language, and never rush your comfort.</p>

        <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-4 mt-8">
          {[
            'Family & cosmetic dentistry',
            'Warm, welcoming team',
            'Modern, comfortable rooms',
            'Care for kids and adults alike',
          ].map((t) => (
            <li class="reveal flex items-center gap-2.5">
              <svg class="w-5 h-5 text-teal-ink shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd" /></svg>
              <span class="text-ink font-medium">{t}</span>
            </li>
          ))}
        </ul>

        <div class="reveal flex flex-wrap gap-3 mt-9">
          <a href="/#book" class="btn btn-primary">Book with our team</a>
          <a href="/#visit" class="btn btn-outline">Find &amp; visit us</a>
        </div>
      </div>

      <!-- Image -->
      <div class="reveal-scale relative order-1 lg:order-2">
        <div class="relative rounded-[1.75rem] overflow-hidden shadow-[0_30px_64px_-34px_rgba(20,50,43,0.7)]">
          <img src="/images/reception.jpg" alt="The bright, calming Maranatha Dental waiting area" class="w-full h-[380px] sm:h-[480px] object-cover" loading="lazy" width="900" height="700" />
        </div>
        <div class="absolute -bottom-6 left-4 sm:left-8 card-soft px-6 py-4 flex items-center gap-4">
          <span class="inline-flex w-11 h-11 rounded-full bg-teal text-white items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
          </span>
          <div>
            <p class="font-semibold text-ink leading-tight">11122 Trask Ave</p>
            <p class="text-ink-soft text-sm">Garden Grove, CA 92843</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
