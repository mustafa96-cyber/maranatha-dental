---
// Comfort & anxiety-free — image-left, overlapping card, warm reassurance.
const points = [
  { title: 'We explain before we do', body: 'You always know what is happening and why — no surprises, no rushing.' },
  { title: 'Gentle with nervous patients', body: 'Tell us you are anxious and we slow down, check in often, and keep you comfortable.' },
  { title: 'Honest, no-pressure advice', body: 'We recommend what you actually need — and tell you what can wait.' },
  { title: 'Calm, modern, clean rooms', body: 'A bright, welcoming space designed to feel more spa than clinic.' },
];
---
<section id="comfort" class="py-20 sm:py-28 scroll-mt-20 overflow-hidden" data-split>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Image with overlapping accent card -->
      <div class="reveal-left relative order-1">
        <div class="relative rounded-[1.75rem] overflow-hidden shadow-[0_30px_64px_-34px_rgba(20,50,43,0.7)]">
          <img src="/images/room.jpg" alt="A Maranatha dentist calmly showing a patient their scan" class="w-full h-[380px] sm:h-[460px] object-cover" loading="lazy" width="900" height="700" />
        </div>
        <div class="absolute -bottom-6 -right-3 sm:right-6 card-soft px-6 py-5 max-w-[15rem] rotate-[2deg]">
          <p class="font-display text-2xl font-semibold text-teal-ink leading-none">“No judgment,<br/>ever.”</p>
          <p class="text-ink-soft text-sm mt-2">Our promise to every patient who walks in.</p>
        </div>
        <div class="absolute -top-5 -left-4 w-16 h-16 rounded-full bg-coral/90 floaty" aria-hidden="true"></div>
      </div>

      <!-- Copy -->
      <div class="order-2">
        <p class="reveal chip text-coral-ink mb-4 flex items-center gap-3"><span class="hair w-9"></span> Comfort first</p>
        <h2 class="reveal font-display text-ink text-[clamp(2rem,4.8vw,3.3rem)] font-semibold leading-[1.03] text-balance">If the dentist makes you nervous, you're exactly who we're for.</h2>
        <p class="reveal text-ink-soft text-base sm:text-lg leading-relaxed mt-5">Many of our patients used to dread dental visits. We built Maranatha to change that — with patience, clear communication, and a genuinely gentle touch.</p>

        <div class="grid sm:grid-cols-2 gap-x-6 gap-y-6 mt-9">
          {points.map((p, i) => (
            <div class="reveal flex gap-3" style={`animation-delay:${i * 90}ms`}>
              <svg class="w-6 h-6 text-teal-ink shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <div>
                <h3 class="font-semibold text-ink">{p.title}</h3>
                <p class="text-ink-soft text-sm leading-relaxed mt-1">{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
